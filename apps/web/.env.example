# Runtime: local, test, or production.
RUNTIME_MODE=

# Host: local or vercel. Production requires vercel and Vercel supplies VERCEL_ENV.
HOST_MODE=
VERCEL_ENV=

# Database: disabled, local-password, or supabase-pooler.
DATABASE_MODE=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_POOL_MAX=
DATABASE_PROBE_TIMEOUT_MS=

# Local development only.
DATABASE_PASSWORD=

# Vercel runtime only. Use a dedicated least-privilege role and transaction endpoint on port 6543.
SUPABASE_DATABASE_PASSWORD=
SUPABASE_DATABASE_ROOT_CERT=

# Authentication: disabled or supabase. Production requires supabase.
AUTH_MODE=
APPLICATION_ORIGIN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Logging: json or silent. Telemetry remains disabled.
LOGGING_MODE=
TELEMETRY_MODE=
NEXT_PUBLIC_RUNTIME_MODE=

# Prohibited: DATABASE_URL, legacy service-role or modern sb_secret keys, migration credentials, and
# Azure Monitor connection strings are intentionally absent from the Vercel runtime example.

    "vercelFunctionRegion": "test-region-1",
    "supabaseProjectRef": "syntheticref",
    "supabaseRegion": "test-region-1"
  },
  "approvals": {
    "vercelProjectConfigured": false,
    "supabaseProjectConfigured": false,
    "supabaseAuthConfigured": false,
    "databaseRolesConfigured": false,
    "migrationEnvironmentProtected": false,
    "deploymentCheckRequired": false,
    "dataResidencyApproved": false,
    "recoveryApproved": false
  },
  "azure": {
    "foundry": {
      "enabled": false
    },
    "monitorExporter": {
      "enabled": false,
      "telemetryMode": "disabled"
    },
    "vercelOidc": {
      "enabled": false,
      "audience": "api://AzureADTokenExchange"
    }
